MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/Forms
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated frontend URLs allowed to call the API (public form, admin panel)
CLIENT_ORIGIN=https://your-form.vercel.app,https://your-admin.vercel.app
PORT=5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local only, if your network breaks mongodb+srv lookups:
# DNS_SERVERS=8.8.8.8,1.1.1.1
